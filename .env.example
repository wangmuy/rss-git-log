# GitHub Configuration
# Create a public GitHub repository for your RSS data

# GitHub repository owner (username or organization)
VITE_GITHUB_OWNER=your-username

# GitHub repository name
VITE_GITHUB_REPO=rss-reader-data

# Branch name (optional, defaults to 'main')
VITE_GITHUB_BRANCH=main

# GitHub Personal Access Token (REQUIRED for write operations)
# IMPORTANT: Never commit this to version control!
# For production, consider using a serverless function instead
# VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Note: For read-only mode with public repos, no token is needed